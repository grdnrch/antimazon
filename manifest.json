{
  "manifest_version": 3,
  "name": "Antimazon",
  "version": "1.0.0",
  "description": "Removes sponsored and excluded search results on Amazon and defaults search sorting to Avg. Customer Review.",
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.com.au/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
