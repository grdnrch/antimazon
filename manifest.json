{
  "manifest_version": 3,
  "name": "Antimazon",
  "version": "1.1.0",
  "description": "Removes sponsored and excluded search results on Amazon (defaulting sort to Avg. Customer Review) and hides ads on Facebook Marketplace.",
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.com.au/*",
        "*://*.facebook.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
